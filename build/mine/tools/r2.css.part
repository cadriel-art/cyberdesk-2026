
/* ===== UX round 2 (R2): table of contents and back to top ===== */
#pages :is(h1,h2,h3,h4){scroll-margin-top:calc(var(--mtop-h,0px) + 14px)}
.u-toc{margin:12px 0 16px;border:1px solid var(--line);border-radius:10px;background:var(--paper);max-width:760px}
.u-toc>summary{cursor:pointer;padding:10px 14px;font-weight:600;font-size:14.5px;min-height:24px}
.u-toc>summary small{color:var(--muted);font-weight:400}
.u-toc[open]>summary{border-bottom:1px solid var(--line)}
.u-toc nav{max-height:min(55vh,420px);overflow:auto;padding:6px 14px 10px}
.u-toc ol{list-style:none;margin:0;padding:0}
.u-toc li{margin:0}
.u-toc li.l3{padding-left:16px}
.u-toc a{display:block;padding:5px 0;font-size:14px;line-height:1.35;color:var(--ink);text-decoration:none}
.u-toc li.l3 a{font-size:13.5px;color:var(--muted)}
.u-toc a:hover{color:var(--accent);text-decoration:underline}
@media (max-width:900px),(pointer:coarse){.u-toc a{padding:9px 0}.u-toc>summary{padding:12px 14px}}
.u-btt{position:fixed;right:max(16px,env(safe-area-inset-right,0px));bottom:max(16px,env(safe-area-inset-bottom,0px));z-index:30;display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:8px 14px;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--ink);font:inherit;font-size:14px;font-weight:600;box-shadow:0 2px 10px rgba(0,0,0,.2);cursor:pointer;opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .2s,transform .2s,visibility 0s .2s}
.u-btt.on{opacity:1;visibility:visible;transform:none;transition:opacity .2s,transform .2s}
.u-btt:hover{border-color:var(--accent)}
.u-btt:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media (max-width:699px){body:has(#p-map:not([hidden]) .mp-drawer:not(:empty)) .u-btt{display:none}.u-btt-t{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.u-btt{min-width:44px;justify-content:center}}
@media print{.u-toc,.u-btt{display:none!important}}
@media (prefers-reduced-motion:reduce){.u-btt{transition:none}}
